# Copy to .env on the VPS and fill in real values before running docker compose.
# DATABASE_URL is set automatically by docker-compose.yml (points at the `db` container) —
# don't set it here.

# Password for the postgres container's `joi` user. Change this from the default.
POSTGRES_PASSWORD="change-me-to-a-long-random-string"

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Gamification
ATTENDANCE_POINTS=10

# Meeting day of week the church meets, 0=Sunday .. 6=Saturday. 5 = Friday.
MEETING_DAY_OF_WEEK=5

# Telegram bot (from @BotFather). Leave blank to run with the bot disabled.
TELEGRAM_BOT_TOKEN=""
# Comma-separated chat IDs (leaders' group and/or individual moderators) that receive the weekly report.
TELEGRAM_ADMIN_CHAT_IDS=""
# Cron schedule for the weekly report, evaluated in Africa/Cairo time. Default = every Friday 13:00.
WEEKLY_REPORT_CRON="0 13 * * 5"

# Google Drive export (service account JSON, either a path or the raw JSON string). Leave blank to disable.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_FOLDER_ID=""

PORT=3000

# Seed moderator account — used only the first time `npm run db:seed:prod` is run.
SEED_MODERATOR_USERNAME="admin"
SEED_MODERATOR_PASSWORD="ChangeMe123"
