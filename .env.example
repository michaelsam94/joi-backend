# Copy this file to .env and fill in real values before running.

# Postgres connection string
DATABASE_URL="postgresql://joi:joi@localhost:5432/joi?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Gamification
ATTENDANCE_POINTS=10

# Meeting day of week the church meets, 0=Sunday .. 6=Saturday. 5 = Friday.
MEETING_DAY_OF_WEEK=5

# Telegram bot (from @BotFather). Leave BOT token blank to run with the bot disabled.
TELEGRAM_BOT_TOKEN=""
# Comma-separated chat IDs (leaders' group and/or individual moderators) that receive the weekly report.
TELEGRAM_ADMIN_CHAT_IDS=""
# Cron schedule for the weekly report, evaluated in Africa/Cairo time. Default = every Friday 13:00.
WEEKLY_REPORT_CRON="0 13 * * 5"

# Google Drive export (service account JSON, either a path or the raw JSON string)
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_FOLDER_ID=""

# Absolute base URL used to build links to uploaded prize images (e.g. "https://joi.michaelsam94.com").
# Leave blank locally — it falls back to building the URL from the incoming request.
PUBLIC_BASE_URL=""

PORT=3000
